# Python backend (set as environment variables, or use local .env via your shell)
SALES_CURRENCY=ZAR
SALES_DB_PATH=data/warehouse.db
SALES_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SALES_MAX_UPLOAD_MB=10

# v2: background scheduler only while the FastAPI process is alive.
# Use a single Uvicorn worker with the local scheduler.
ORANEO_SCHEDULER_ENABLED=true

# Render-only settings; provide credentials in Render dashboard, not this file:
# ORANEO_AUTH_USER=oraneo
# ORANEO_AUTH_PASSWORD=
# ORANEO_SEED_ON_FIRST_BOOT=true
# SALES_DB_PATH=/var/data/warehouse.db
